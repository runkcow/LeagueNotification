CREATE TABLE IF NOT EXISTS accounts (
	puuid TEXT NOT NULL PRIMARY KEY, /* account puuid */
	username TEXT NOT NULL,
	tag TEXT NOT NULL,
	elo INTEGER NOT NULL, /* 0 if unranked */
	wins INTEGER NOT NULL,
	losses INTEGER NOT NULL,
	region TEXT NOT NULL,
	match_id TEXT /* null is an indication of not in match */
);


/* refactor these columns to end with '_id' except puuid */
CREATE TABLE IF NOT EXISTS servers (
	puuid TEXT NOT NULL,
	server TEXT NOT NULL, 
	channel TEXT NOT NULL,
	message TEXT,  
	PRIMARY KEY (puuid, server),
	FOREIGN KEY (puuid) REFERENCES accounts(puuid) ON DELETE CASCADE
);

/* for now, the only purpose of this table is to track lp changes */
/* might add more in the future */ 
CREATE TABLE IF NOT EXISTS matches (
	puuid TEXT NOT NULL, 
	match_id TEXT NOT NULL, 
	lp INTEGER NOT NULL,
	elo INTEGER NOT NULL, /* after the game */
	PRIMARY KEY (puuid, match_id)
	FOREIGN KEY (puuid) REFERENCES accounts(puuid) ON DELETE CASCADE
);
</sql><sql name="SQL 2">DROP TABLE IF EXISTS accounts;
DROP TABLE IF EXISTS servers;
DROP TABLE IF EXISTS matches;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
